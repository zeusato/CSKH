VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Never prefix a privileged key with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-server-key
# Either connection method can apply SQL migrations.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# Optional CA file from Supabase Dashboard. TLS/hostname verification stays enabled.
# For IPv4-only networks, use the session pooler URL copied from Supabase Connect.
DATABASE_SSL_CA_FILE=
SUPABASE_ACCESS_TOKEN=
# Required when creating the initial administrator.
ADMIN_EMAIL=
ADMIN_NAME=
APP_URL=http://localhost:5173
# Optional public canonical origin for OG links (custom production domain).
# On Vercel, omit to use the project's production domain automatically.
SITE_URL=
# Chat Gateway: chỉ dùng cho npm run deploy:chat-secrets (xem docs/CHAT.md). Khóa đọc từ file, không dán vào .env.
CHAT_GATEWAY_URL=
CHAT_ASSERTION_KID=
CHAT_ASSERTION_PRIVATE_KEY_FILE=
CHAT_ADMIN_KEY_FILE=
# Tùy chọn: mặc định APP_URL và http://127.0.0.1:5173
CHAT_ALLOWED_ORIGINS=
