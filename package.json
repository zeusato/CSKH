{
  "name": "shs-cskh-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-env.mjs && tsc -b && vite build && node scripts/check-static-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check:git": "node scripts/check-git-ready.mjs",
    "check:release": "npm test && npm run build && npm run check:git",
    "db:inspect": "node --env-file=.env scripts/inspect-supabase.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:test": "node --env-file=.env scripts/test-database.mjs",
    "bootstrap": "node --env-file=.env scripts/bootstrap-admin.mjs",
    "test:care-db": "node scripts/test-care-database.mjs",
    "test:care-ui": "node scripts/test-care-ui.mjs",
    "test:library-db": "node scripts/test-library-database.mjs",
    "test:library-ui": "node scripts/test-library-ui.mjs",
    "test:call-db": "node scripts/test-call-database.mjs",
    "test:call-ui": "node scripts/test-call-ui.mjs",
    "test:chat-db": "node scripts/test-chat-database.mjs",
    "test:chat-gateway": "vitest run src/lib/chat/gateway.integration.test.ts",
    "test:chat-ui": "node scripts/test-chat-ui.mjs",
    "test:chat-latency": "node scripts/test-chat-latency.mjs",
    "deploy:chat-secrets": "node --env-file=.env scripts/deploy-functions.mjs --chat-secrets"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@jsquash/webp": "1.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "lucide-react": "1.45.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-router-dom": "7.18.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "pg": "8.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
